{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "backseatbingo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "ratelimits": [
    {
      "name": "CREATE_ROOM_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      // Room lookups and socket upgrades. Generous enough for a car of phones
      // on one hotspot reconnecting, slow enough that guessing codes is not.
      "name": "ROOM_LOOKUP_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 120, "period": 60 }
    }
  ],
  "observability": { "enabled": true },
  "env": {
    // What .github/workflows/previews.yml deploys, under a per-PR `--name`.
    // Rate-limit namespaces are account-wide, so previews get ids of their
    // own rather than spending production's per-IP budget. An env does not
    // inherit Durable Objects, migrations or rate limits, hence the repeats.
    "preview": {
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RoomDO" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
      "ratelimits": [
        {
          "name": "CREATE_ROOM_LIMITER",
          "namespace_id": "2001",
          "simple": { "limit": 10, "period": 60 }
        },
        {
          "name": "ROOM_LOOKUP_LIMITER",
          "namespace_id": "2002",
          "simple": { "limit": 120, "period": 60 }
        }
      ]
    }
  }
}
